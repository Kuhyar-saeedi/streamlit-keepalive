name: Keep Streamlit apps awake

on:
  schedule:
    - cron: "17 */6 * * *"   # every 6 hours (UTC)
  workflow_dispatch:          # manual "Run workflow" button

permissions:
  contents: write             # needed for the heartbeat commit below

jobs:
  wake:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Playwright
        run: |
          pip install playwright
          python -m playwright install --with-deps chromium

      - name: Wake apps
        run: python wake.py

      # GitHub disables scheduled workflows after 60 days without repo activity.
      # Commit a heartbeat only if the last commit is older than 30 days.
      - name: Heartbeat commit
        if: always()
        run: |
          last=$(git log -1 --format=%ct)
          now=$(date +%s)
          if [ $(( (now - last) / 86400 )) -ge 30 ]; then
            date -u > heartbeat.txt
            git config user.name  "github-actions[bot]"
            git config user.email "41898283+github-actions[bot]@users.noreply.github.com"
            git add heartbeat.txt
            git commit -m "heartbeat: keep scheduled workflow enabled"
            git push
          fi
